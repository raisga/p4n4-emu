# Generated by p4n4-emu — DO NOT EDIT
# Profile: {{ profile.name }} | {{ profile.description }}
services:
  ei-runner:
    {% if profile.is_arm %}
    platform: linux/{{ profile.arch }}
    {% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ "%.2f"|format(profile.cpus * 0.25) }}"
          memory: "{{ (profile.memory_mb * 0.10)|int }}m"
    {% if blkio_device %}
    blkio_config:
      weight: {{ profile.blkio_weight }}
      device_read_bps:
        - path: "{{ blkio_device }}"
          rate: "{{ profile.blkio_read_bps }}"
      device_write_bps:
        - path: "{{ blkio_device }}"
          rate: "{{ profile.blkio_write_bps }}"
    {% endif %}
