# Generated by p4n4-emu — DO NOT EDIT
# Profile: {{ profile.name }} | {{ profile.description }} | Stack: {{ stack }}
{% if not services %}
services: {}
{% else %}
services:
{% for svc in services %}
  {{ svc.name }}:
    {% if platform %}
    platform: {{ platform }}
    {% endif %}
    deploy:
      resources:
        limits:
          cpus: "{{ svc.cpus }}"
          memory: "{{ svc.memory_mb }}m"
    memswap_limit: "{{ svc.memswap_mb }}m"
    {% if blkio_device %}
    blkio_config:
      weight: {{ profile.blkio_weight }}
      device_read_bps:
        - path: "{{ blkio_device }}"
          rate: "{{ profile.blkio_read_bps }}"
      device_write_bps:
        - path: "{{ blkio_device }}"
          rate: "{{ profile.blkio_write_bps }}"
    {% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
{% endif %}
