#cloud-config
# docs/guides/aws.md, section 4.2
package_update: true
packages: [ca-certificates, curl, git, jq]

write_files:
  - path: /etc/docker/daemon.json
    content: |
      { "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "5" } }

runcmd:
  - shutdown -P +${ttl_minutes} "p4n4 emulator TTL reached"
%{ if install_docker ~}
  - curl -fsSL https://get.docker.com | sh
%{ endif ~}
  - usermod -aG docker ubuntu
  - snap install aws-cli --classic
  - su - ubuntu -c 'curl -LsSf https://astral.sh/uv/install.sh | sh'
  - su - ubuntu -c 'mkdir -p p4n4/tools && git clone -q --branch ${git_refs.lib} https://github.com/raisga/p4n4-lib p4n4/lib && git clone -q --branch ${git_refs.emu} https://github.com/raisga/p4n4-emu p4n4/tools/emu && git clone -q --branch ${git_refs.templates} https://github.com/raisga/p4n4-templates p4n4/tools/templates'
  - su - ubuntu -c '~/.local/bin/uv tool install ~/p4n4/tools/emu --with ~/p4n4/lib'
